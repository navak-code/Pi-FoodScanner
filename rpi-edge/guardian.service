[Unit]
Description=Guardian Edge Dietary & Environmental Daemon
After=network.target ollama.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/guardian-system/rpi-edge
ExecStart=/usr/bin/python3 /home/pi/guardian-system/rpi-edge/server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
